# See ENV.md for the full inventory.
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# --- Required ---
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_WORKFLOW_CONTACT_AUTORESPONDER_ID=
SITE_URL=https://dodiekendall.com
# Cloudflare Web Analytics token (cookie-free). Blank = no analytics.
PUBLIC_CF_BEACON_TOKEN=

# Cloudflare Turnstile on the free-guide sign-up. Site key is build-time
# (.env.production); the secret is a Worker secret (locally in .dev.vars).
# Local dev falls back to Cloudflare's always-pass test site key; pair it with
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA in .dev.vars.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta (Facebook) Pixel ID — 15-16 digit numeric ID from Facebook Events Manager.
# When set, src/components/shared/MetaPixel.astro emits the pixel base code +
# PageView tracking on every page. Leave blank to render nothing.
PUBLIC_FB_PIXEL_ID=

# --- Fallback email (decide provider in ADR-003) ---
# Pick one:
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
FALLBACK_EMAIL_TO=dodiekendall@gmail.com
FALLBACK_EMAIL_FROM=no-reply@dodiekendall.com

# --- Optional / future ---
# SENTRY_DSN=
# LOGFLARE_API_KEY=
# BOOKING_CALENDAR_FALLBACK_URL=
