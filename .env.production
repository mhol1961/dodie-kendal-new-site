# Build-time vars for production builds. COMMITTED: Cloudflare's GitHub build (push to
# main) reads them from here. PUBLIC values only (they ship in the HTML); never put a
# secret here. Secrets live on the Worker (wrangler secret put).
# Turnstile site key for the dodiekendall.com widget (public value). See ENV.md.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFM2euvUYEivwvlo
# Meta (Facebook) Pixel ID (public value; MetaPixel.astro, production builds only, never the preview).
PUBLIC_FB_PIXEL_ID=29768094666114249
