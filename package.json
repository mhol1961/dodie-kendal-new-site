{
  "name": "dodiekendall-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "dodiekendall.com — Dodie Kendall QHHT practice site. Astro + Tailwind + shadcn-ported primitives.",
  "scripts": {
    "dev": "astro dev --port 5400 --host",
    "start": "astro dev --port 5400 --host",
    "build": "astro build",
    "postbuild": "node scripts/strip-claude-pages.mjs && node scripts/sitemap-drop-noindex.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler d1 migrations apply dodie-lead-limits --remote && wrangler d1 execute dodie-lead-limits --remote --command \"SELECT 1 FROM guide_sends LIMIT 1; SELECT 1 FROM ip_hits LIMIT 1; SELECT 1 FROM form_submissions LIMIT 1\" && wrangler deploy",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write \"**/*.{js,ts,astro,md,json}\"",
    "test:e2e": "playwright test",
    "test:feed": "node --experimental-strip-types --test test/youtube-feed.test.mjs",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^1.2.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
