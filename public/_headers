# Guides must never be served stale (phones cache PDFs hard): always revalidate.
# PDFs only: the photos in /dodie/ should stay cacheable.
/dodie-kendall-prep-guide.pdf
  Cache-Control: no-cache
/dodie/qhht-pre-session-prep-guide.pdf
  Cache-Control: no-cache
/dodie/QHHT%20Pre-session%20preparation%20guide.pdf
  Cache-Control: no-cache

# Link-preview cards (og:image). Long cache so iMessage, Facebook etc. fetch them
# fast; the URLs stay the same, so a changed card can take up to a week to show.
/og/*
  Cache-Control: public, max-age=604800
