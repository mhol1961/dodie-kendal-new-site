---
/**
 * "Areas I serve": links to the local-area pages built in this build (released
 * towns, or all of them in a PUBLIC_SITE_PREVIEW=1 build). Renders nothing when
 * no town is built, so unreleased towns never leak a link.
 */
import { builtAreas } from '@/data/areas/index.ts';

const areas = builtAreas();
---
{areas.length > 0 && (
  <section class="section-y bg-bg-sunken">
    <div class="container-default">
      <header class="mb-8 max-w-2xl">
        <p class="text-xs uppercase tracking-[0.22em] text-brand">Areas I serve</p>
        <h2 class="mt-3 font-display text-ink">Coming to Stuart from nearby.</h2>
        <p class="mt-5 text-lg text-ink-secondary">Every session is in person at my studio in Stuart. Directions and drive times from your town:</p>
      </header>
      <ul class="flex flex-wrap gap-3">
        {areas.map((a) => (
          <li><a href={`/qhht/${a.slug}`} class="inline-flex rounded-pill border border-border-subtle bg-bg-raised px-5 py-2 text-ink transition-colors hover:border-brand hover:text-brand">{a.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}
