---
/**
 * BookingEmbed — wraps Dodie's GHL calendar iframe in our card styling.
 *
 * IMPORTANT: This component does NOT read import.meta.env. The parent page must
 * be SSR (prerender = false) and pass `calendarId` and `fallbackUrl` from
 * the Worker env (`cloudflare:workers`). This way Cloudflare runtime env swaps take effect
 * without a rebuild (see ADR-004 Option A — applied to the /book surface only).
 */
interface Props {
  calendarId?: string;
  fallbackUrl?: string;
  title?: string;
}

const { calendarId, fallbackUrl = '', title = 'Book a QHHT session with Dodie Kendall' } = Astro.props;

const embedUrl = calendarId
  ? `https://api.leadconnectorhq.com/widget/booking/${calendarId}`
  : null;
// GHL's own embed snippet ids booking iframes `<calendarId>_<timestamp>`.
const iframeId = `${calendarId}_${Date.now()}`;
---
<div class="overflow-hidden rounded-lg border border-border-subtle bg-bg-raised shadow-lg">
  {embedUrl ? (
    <>
      {/* src is set by the script below (ad details appended), then GHL's form_embed.js
          sizes the frame to its content. min-height is the floor. */}
      <iframe
        data-booking-src={embedUrl}
        id={iframeId}
        title={title}
        referrerpolicy="strict-origin-when-cross-origin"
        style="width: 100%; min-height: 600px; border: 0;"
      />
      {/* Always-visible plain link: if the script that sets the iframe src fails
          (blocked or stale chunk), the calendar is still one tap away. */}
      <p class="border-t border-border-subtle px-4 py-3 text-center text-sm text-ink-muted">
        Calendar not loading?
        <a href={embedUrl} target="_blank" rel="noopener noreferrer" class="text-brand underline hover:text-brand-hover">Open it in a new tab</a>
      </p>
    </>
  ) : (
    <div class="p-8 text-center md:p-12">
      <p class="text-xs uppercase tracking-wider text-ink-muted">Calendar setup pending</p>
      <h3 class="mt-3 font-display text-2xl">Booking calendar configuration is in progress.</h3>
      <p class="mx-auto mt-4 max-w-lg text-ink-secondary">
        To book directly while the calendar is being configured, please contact Dodie:
      </p>
      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-lg">
        <a href="tel:+17722475534" class="text-brand underline hover:text-brand-hover">772-247-5534</a>
        <span class="text-ink-muted" aria-hidden="true">·</span>
        <a href="mailto:dodiekendall@gmail.com" class="text-brand underline hover:text-brand-hover">dodiekendall@gmail.com</a>
      </p>
      {fallbackUrl && (
        <p class="mt-6">
          <a
            href={fallbackUrl}
            class="inline-flex items-center justify-center rounded-pill bg-brand px-7 py-3 font-medium text-ink-inverse shadow-md transition-all hover:bg-brand-hover hover:shadow-glow"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open calendar in a new window →
          </a>
        </p>
      )}
    </div>
  )}
</div>

<script>
  import { readAttribution } from '@lib/attribution-client';
  import { bookingUrl } from '@lib/booking-url';

  // Bundled once per page however many calendars render. Give each calendar the
  // visit's ad details, then load GHL's resizer, which sizes each /booking frame to
  // its content. Order matters: the resizer only adopts frames that already have
  // their src when it starts, so no loading="lazy" or late src (a lazy frame gets
  // parked off-screen by the resizer and never loads).
  const attr = readAttribution();
  const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-booking-src]');
  frames.forEach((f) => {
    f.src = bookingUrl(f.dataset.bookingSrc!, attr);
  });
  if (frames.length) {
    const s = document.createElement('script');
    s.src = 'https://link.msgsndr.com/js/form_embed.js';
    document.body.append(s);
  }
</script>
