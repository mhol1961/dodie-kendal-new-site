---
/**
 * ContactForm: the /contact form, posting to /api/contact behind Turnstile.
 * Same questions, labels, placeholders and order as Dodie's GHL "QHHT Quiz" form it
 * replaced (Sv6wLoRU5khzSvRlNYWf), so nothing changes for the visitor. The API gives
 * the contact the tags that form's leads got (qhht-lead, qhht-quiz-complete).
 * Needs JavaScript (Turnstile); without it the <noscript> note offers phone and email.
 */
import Input from '@components/ui/Input.astro';
import TurnstileWidget from '@components/TurnstileWidget.astro';
import { CONTACT_GOALS } from '@lib/quiz';

const checkbox = 'mt-1 h-4 w-4 shrink-0 rounded border-border-strong text-brand focus:ring-brand';
---
<div data-contact-root>
  <form id="contact-form" action="/api/contact" method="POST" class="space-y-5" novalidate>
    <Input id="contact-first" name="firstName" label="First Name" required autocomplete="given-name" placeholder="Enter your first name" />
    <Input id="contact-last" name="lastName" label="Last Name" autocomplete="family-name" placeholder="Enter your last name" />
    <Input id="contact-phone" name="phone" type="tel" label="Phone" required autocomplete="tel" placeholder="+1 (555) 000-0000" />
    <Input id="contact-email" name="email" type="email" label="Email" required autocomplete="email" placeholder="your@email.com" />

    <div>
      <label for="contact-goal" class="mb-1.5 block text-sm font-medium text-ink">
        What's drawing you to QHHT?<span aria-hidden="true" class="ml-0.5 text-brand">*</span>
      </label>
      <select
        id="contact-goal"
        name="quizGoal"
        required
        class="block w-full rounded-md border border-border-strong bg-bg-raised px-4 py-2.5 text-ink invalid:text-ink-muted focus:border-brand focus:outline-none transition-colors duration-base"
      >
        <option value="" disabled selected>What's drawing you to QHHT?</option>
        {CONTACT_GOALS.map((g) => <option value={g}>{g}</option>)}
      </select>
    </div>

    <!-- Honeypot: not visible, not focusable, not announced -->
    <Input id="contact-trap" name="website" label="Website (leave blank)" visuallyHidden ariaHidden tabIndex={-1} inputClass="hidden" />

    <label class="flex items-start gap-3 text-sm text-ink-secondary">
      <input type="checkbox" name="consentTransactional" value="true" class={checkbox} />
      <span>By checking this box, I consent to receive non-marketing text messages from Dodie Kendall QHHT about appointment confirmations, session reminders, and after-care. Message frequency varies, message &amp; data rates may apply. Text HELP for assistance, reply STOP to opt out.</span>
    </label>
    <label class="flex items-start gap-3 text-sm text-ink-secondary">
      <input type="checkbox" name="consentMarketing" value="true" class={checkbox} />
      <span>By checking this box, I consent to receive marketing and promotional messages including special offers, discounts, new product updates among others, from Dodie Kendall QHHT at the phone number provided. Frequency may vary. Message &amp; data rates may apply. Text HELP for assistance, reply STOP to opt out.</span>
    </label>

    <TurnstileWidget />

    <button
      type="submit"
      class="inline-flex w-full items-center justify-center rounded-pill bg-brand px-7 py-3 font-medium text-ink-inverse shadow-md transition-all hover:bg-brand-hover hover:shadow-glow disabled:opacity-60"
    >
      Submit
    </button>

    <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
    <noscript>
      <p class="text-sm text-ink-secondary">This form needs JavaScript for its security check. Please call 772-247-5534 or email dodiekendall@gmail.com.</p>
    </noscript>

    <p class="text-center text-sm text-ink">
      <a href="/privacy" class="font-medium underline">Privacy Policy</a> | <a href="/terms" class="font-medium underline">Terms of Service</a>
    </p>
  </form>

  <div data-contact-success hidden tabindex="-1" class="py-10 text-center text-lg font-semibold leading-relaxed text-ink">
    Thank you, and welcome. I'm so glad your curiosity brought you here. I'll be in touch shortly. Whenever you are ready, you can
    <a href="/book#discovery" class="text-brand underline underline-offset-2 hover:text-brand-hover">book your free discovery call here</a>.
  </div>
</div>

<script>
  import { readAttribution, trackLead } from '@lib/attribution-client';
  import { waitForTurnstileToken } from '@lib/lead-magnet-form';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const success = document.querySelector<HTMLElement>('[data-contact-success]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const say = (text: string) => {
    if (status) { status.textContent = text; status.className = 'text-sm text-error'; }
  };
  // Tokens are single-use: every attempt that didn't succeed needs a fresh one.
  const resetCheck = () => {
    const ts = (window as { turnstile?: { reset: (el: Element) => void } }).turnstile;
    const widget = form?.querySelector('.cf-turnstile');
    if (ts && widget) ts.reset(widget);
  };

  let busy = false;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy) return;
    if (!form.checkValidity()) {
      say('Please complete the required fields.');
      form.querySelector<HTMLElement>(':invalid')?.focus();
      return;
    }
    const fd = new FormData(form);
    if (String(fd.get('website') ?? '')) return; // honeypot
    busy = true;
    if (button) { button.disabled = true; button.textContent = 'Sending…'; }
    if (status) { status.textContent = ''; }
    const token = await waitForTurnstileToken(form);
    let res: Response | null = null;
    if (token) {
      try {
        res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: String(fd.get('firstName') ?? '').trim(),
            lastName: String(fd.get('lastName') ?? '').trim() || undefined,
            phone: String(fd.get('phone') ?? '').trim(),
            email: String(fd.get('email') ?? '').trim(),
            quizGoal: String(fd.get('quizGoal') ?? ''),
            consentTransactional: fd.get('consentTransactional') === 'true',
            consentMarketing: fd.get('consentMarketing') === 'true',
            website: '',
            'cf-turnstile-response': token,
            attribution: readAttribution(),
          }),
        });
      } catch {
        /* network failure: handled below */
      }
    }
    // 200 = saved in GHL, 202 = GHL down but the details reached Dodie by email.
    if (res && (res.status === 200 || res.status === 202)) {
      trackLead();
      form.hidden = true;
      if (success) { success.hidden = false; success.focus(); }
    } else {
      if (!token || res?.status === 400) say('Please complete the security check above, then submit again.');
      else if (res?.status === 422) say('Please check your details and try again.');
      else say('Something went wrong sending that. Please try again, or email dodiekendall@gmail.com. That always works.');
      resetCheck();
      if (button) { button.disabled = false; button.textContent = 'Submit'; }
      busy = false;
    }
  });
</script>
