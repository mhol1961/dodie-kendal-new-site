---
/**
 * Cloudflare Turnstile (managed, interaction-only: the box shows only when a
 * visitor actually has to click) for the site's forms. Place inside the
 * <form>: the widget adds a hidden cf-turnstile-response field, checked by
 * /api/lead-magnet. The site key is inlined at build time from
 * PUBLIC_TURNSTILE_SITE_KEY (see ENV.md). Dev uses Cloudflare's always-pass
 * test key, paired with the test secret in .dev.vars.
 */
const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
if (!siteKey) {
  throw new Error(
    'PUBLIC_TURNSTILE_SITE_KEY is not set: every free-guide sign-up would be rejected. Add it to .env.production (see ENV.md).'
  );
}
// Town pages (/qhht/{town}) never link straight to the PDF: send them to the sign-up page.
const onTownPage = Astro.url.pathname.startsWith('/qhht/');
---
<div
  class="cf-turnstile mt-4"
  data-sitekey={siteKey}
  data-theme="light"
  data-appearance="interaction-only"
  data-error-callback="onLeadMagnetTurnstileError"
></div>
<noscript>
  <p class="mt-4 text-sm text-ink-secondary">
    This sign-up needs JavaScript.
    {onTownPage ? (
      <>You can also get the guide from the <a href="/free-guide" class="font-semibold underline text-brand">free guide page</a>.</>
    ) : (
      <>You can still <a href="/dodie-kendall-prep-guide.pdf" class="font-semibold underline text-brand">open the guide directly</a>.</>
    )}
  </p>
</noscript>
<script is:inline>
  // Load Turnstile (~500 KB) only when a form is near the screen or being used, not
  // on every page view: most forms sit below the fold. Implicit rendering picks up
  // every .cf-turnstile on the page once the script arrives.
  (function () {
    if (window.__tsWatch) return;
    window.__tsWatch = true;
    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      s.async = true;
      document.head.appendChild(s);
    }
    document.addEventListener('focusin', function (e) {
      if (e.target && e.target.closest && e.target.closest('form')) load();
    });
    if (!('IntersectionObserver' in window)) return load();
    var io = new IntersectionObserver(function (entries) {
      if (entries.some(function (en) { return en.isIntersecting; })) { io.disconnect(); load(); }
    }, { rootMargin: '600px 0px' });
    document.querySelectorAll('.cf-turnstile').forEach(function (el) { io.observe(el); });
  })();
</script>
