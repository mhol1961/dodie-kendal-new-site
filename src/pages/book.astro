---
import { env as workerEnv } from 'cloudflare:workers';
import Base from '@layouts/Base.astro';
import BookingEmbed from '@components/BookingEmbed.astro';
import TestimonialGrid from '@components/TestimonialGrid.astro';
import YouTubePreview from '@components/YouTubePreview.astro';
import { getSeo } from '@lib/seo';
import { qhhtService, breadcrumb } from '@lib/schema';

// Pricing section below the price/deposit/duration tiles; null renders nothing.
// Balance due date intentionally not stated until Dodie confirms it.
interface Pricing {
  heading: string;
  intro?: string;
  items?: Array<{ label: string; price: string; note?: string }>;
}
const pricing: Pricing | null = {
  heading: '$300 per session. A $50 deposit reserves your time.',
  intro: 'Your session includes the pre-session conversation, the hypnosis session itself, and your audio recording to keep. You pay the deposit when you book, and the calendar confirms your time instantly by email.',
};

// SSR for /book — calendar ID must resolve from Cloudflare runtime env, not build time.
// See ADR-004 (Option A, applied to this page only).
export const prerender = false;

const env = workerEnv as unknown as Record<string, string | undefined>;
const calendarId = env.GHL_CALENDAR_ID;
const discoveryCalendarId = env.GHL_DISCOVERY_CALENDAR_ID;
const fallbackUrl = env.BOOKING_CALENDAR_FALLBACK_URL;

const seo = getSeo({
  path: '/book',
  title: 'Book a QHHT Session',
  description:
    'Book a QHHT session with Dodie Kendall in Stuart, FL: about five hours in person, $300 total with a $50 deposit. Or start with a free 30-minute call.',
});

const schemas = [
  qhhtService(),
  breadcrumb([
    { name: 'Home', href: '/' },
    { name: 'Book' },
  ]),
];

const next = [
  {
    num: '01',
    title: 'Confirmation email',
    body: "Right after you book, you'll get an email confirming your date and time, with the studio address and instructions for the $250 balance.",
  },
  {
    num: '02',
    title: 'Pre-session prep guide',
    body: "Two days before your session, I'll send you my prep guide to look over. It's short. You can read through it in about 20 minutes.",
  },
  {
    num: '03',
    title: 'Day-of check-in',
    body: "The morning of your session, I'll send a brief check-in text so you know what to expect.",
  },
];
---
<Base seo={seo} schemas={schemas}>
  <section class="section-y bg-bg-base">
    <div class="container-default max-w-4xl">
      <p class="text-xs uppercase tracking-wider text-ink-muted">Booking</p>
      <h1 class="mt-2 font-display">Select a time that feels right.</h1>
      <p class="mt-4 max-w-prose text-lg leading-relaxed text-ink-secondary">
        There are two ways to begin. If you're new to QHHT or still deciding, start with a free call. If you already know, reserve your session below.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {discoveryCalendarId && (
          <a href="#discovery" class="inline-flex min-h-[44px] items-center justify-center rounded-pill border border-border-strong bg-bg-raised px-6 py-2.5 text-base font-medium text-ink transition-colors hover:border-brand hover:text-brand">
            Free 30-minute call
          </a>
        )}
        <a href="#reserve" class="inline-flex min-h-[44px] items-center justify-center rounded-pill bg-brand px-6 py-2.5 text-base font-medium text-ink-inverse shadow-sm transition-all hover:bg-brand-hover hover:shadow-md">
          Reserve a session · $50 deposit
        </a>
      </div>

      {discoveryCalendarId && (
        <div id="discovery" class="mt-10 scroll-mt-24 rounded-lg border border-border-subtle bg-bg-sunken p-5 md:p-8">
          <p class="text-xs uppercase tracking-wider text-brand">New to QHHT? Start here</p>
          <h2 class="mt-2 font-display">A free 30-minute call.</h2>
          <p class="mt-4 max-w-prose text-lg leading-relaxed text-ink-secondary">
            We'll talk about what's drawing you to QHHT, what a session looks like, and whether it feels right for you. No cost and no commitment.
          </p>
          <div class="mt-8">
            <BookingEmbed calendarId={discoveryCalendarId} title="Book a free 30-minute discovery call with Dodie Kendall" />
          </div>
        </div>
      )}

      <div id="reserve" class="mt-16 scroll-mt-24">
        <p class="text-xs uppercase tracking-wider text-ink-muted">Ready for your session?</p>
        <h2 class="mt-2 font-display">Reserve your QHHT session.</h2>

        <div class="mt-8 grid gap-8 md:grid-cols-3">
          <div class="rounded-lg border border-border-subtle bg-bg-raised p-5 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-ink-muted">Total</p>
            <p class="mt-1 font-display text-3xl text-ink">$300</p>
            <p class="mt-1 text-xs text-ink-secondary">All-inclusive · session + recording</p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-raised p-5 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-ink-muted">Deposit at booking</p>
            <p class="mt-1 font-display text-3xl text-ink">$50</p>
            <p class="mt-1 text-xs text-ink-secondary">Reserves your time</p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-raised p-5 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-ink-muted">Duration</p>
            <p class="mt-1 font-display text-3xl text-ink">~5 hours</p>
            <p class="mt-1 text-xs text-ink-secondary">About 2 hrs conversation · 2 to 3 hrs session · plus your recording</p>
          </div>
        </div>

        {pricing && (
          <div class="mt-10 rounded-lg border border-border-subtle bg-bg-raised p-5 shadow-sm md:p-8">
            <p class="text-xs uppercase tracking-wider text-ink-muted">Pricing</p>
            <h3 class="mt-2 font-display text-2xl text-ink">{pricing.heading}</h3>
            {pricing.intro && <p class="mt-3 max-w-prose leading-relaxed text-ink-secondary">{pricing.intro}</p>}
            {pricing.items && pricing.items.length > 0 && <dl class="mt-6 divide-y divide-border-subtle">
              {pricing.items.map((item) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                  <dt class="text-ink">
                    {item.label}
                    {item.note && <span class="block text-xs text-ink-secondary">{item.note}</span>}
                  </dt>
                  <dd class="font-display text-2xl text-ink">{item.price}</dd>
                </div>
              ))}
            </dl>}
          </div>
        )}
      </div>
    </div>
  </section>

  <TestimonialGrid />

  <section class="section-y bg-bg-base">
    <div class="container-default max-w-4xl">
      <div class="max-w-prose space-y-5 text-lg leading-relaxed text-ink-secondary">
        <p>
          Plan for about five hours together: about two hours of conversation, then two to three hours in the session itself. All sessions are in person at my Stuart, FL studio, and completely confidential.
        </p>
        <p>
          If you've never done a QHHT session, that's exactly the right starting point. Most clients haven't. Before we meet, I'll send you a short prep guide and we'll have a quick call so you arrive ready.
        </p>
      </div>

      <div class="mt-10 rounded-lg border border-border-subtle bg-bg-sunken p-5 text-sm text-ink-secondary md:p-6">
        <strong class="font-medium text-ink">By scheduling, I understand:</strong>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          <li>QHHT is a complementary practice, not medical or psychological treatment.</li>
          <li>Sessions do not diagnose, treat, cure, or prevent any disease.</li>
          <li>Dodie is a QHHT Practitioner trained in the Dolores Cannon lineage, not a licensed physician, psychologist, or psychotherapist.</li>
          <li>My participation is voluntary.</li>
        </ul>
      </div>

      <div class="mt-12">
        <BookingEmbed calendarId={calendarId} fallbackUrl={fallbackUrl} />
      </div>

      <div class="mt-16">
        <header class="mb-6 max-w-2xl">
          <p class="text-xs uppercase tracking-wider text-ink-muted">Prepare for your session</p>
          <h2 class="mt-3 font-display">Watch this first.</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-secondary">
            Booked your session? Watch this first. Dodie walks you through 4 things to do before your first QHHT session.
          </p>
        </header>
        <div class="overflow-hidden rounded-lg border border-border-subtle bg-bg-sunken shadow-sm">
          <YouTubePreview id="2HXMMojPaPQ" title="4 Things You MUST Do Before Your First Hypnotherapy Session" />
        </div>
      </div>

      <div class="mt-16">
        <header class="mb-8 max-w-2xl">
          <p class="text-xs uppercase tracking-wider text-ink-muted">What happens next</p>
          <h2 class="mt-3 font-display">From booking to session day.</h2>
        </header>
        <ol class="grid gap-6 md:grid-cols-3" role="list">
          {next.map((n) => (
            <li class="rounded-lg border border-border-subtle bg-bg-raised p-6 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-pill bg-sage/20 font-display text-base text-ink" aria-hidden="true">{n.num}</div>
              <h3 class="mt-4 font-display text-xl">{n.title}</h3>
              <p class="mt-2 text-ink-secondary leading-relaxed">{n.body}</p>
            </li>
          ))}
        </ol>
      </div>

      <p class="mt-10 text-sm text-ink-muted">
        Your information is held confidentially and used only to coordinate your session and follow-up. See our
        <a href="/privacy" class="text-brand underline">Privacy Policy</a> for details.
      </p>
    </div>
  </section>
</Base>
