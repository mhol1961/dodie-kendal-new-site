---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import LatestVideos from '@components/LatestVideos.astro';
import ClosingCTA from '@components/ClosingCTA.astro';
import { getSeo } from '@lib/seo';
import { breadcrumb } from '@lib/schema';

const seo = getSeo({
  path: '/videos',
  title: 'Videos',
  description:
    'Watch Dodie Kendall talk through QHHT, the Subconscious, and what unfolds in a session: the latest videos from her YouTube channel.',
});

const schemas = [breadcrumb([{ name: 'Home', href: '/' }, { name: 'Videos' }])];
---
<Base seo={seo} schemas={schemas}>
  <Hero
    variant="insights"
    eyebrow="Videos"
    headlineLead="See it in her"
    headlineItalic="own words."
    subhead="Dodie on QHHT, the Subconscious, and the questions people bring to a session. New videos appear here as soon as they go up on YouTube."
    bgImage="/video/doorway-opens-poster.jpg"
    bgPosition="center"
  />

  <!--
    Crawlable / no-JS fallback. LatestVideos removes this the moment it has
    real cards to show, so visitors never see both. Without it, a JS-less or
    feed-less visit would land on a page with a hero and nothing else.
  -->
  <section class="section-y bg-bg-base" data-videos-fallback>
    <div class="container-default">
      <header class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.22em] text-brand">From the channel</p>
        <h2 class="mt-3 font-display text-ink">
          <span class="block">Recent videos</span>
          <span class="italic-accent block text-brand">from Dodie.</span>
        </h2>
        <p class="mt-5 text-lg text-ink-secondary leading-relaxed">
          Dodie posts new talks on QHHT, the Subconscious, and what unfolds in a session.
          Every video lives on her YouTube channel.
        </p>
      </header>
      <div class="mt-10">
        <a
          href="https://www.youtube.com/@dodiekendallQHHT"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-pill border border-border-strong bg-bg-base px-6 py-2.5 text-sm text-ink transition-colors hover:border-brand hover:text-brand"
        >
          View all videos on YouTube
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <LatestVideos
    limit={15}
    eyebrow="From the channel"
    heading="Recent videos"
    headingItalic="from Dodie."
    subhead="Dodie's most recent uploads, newest first. Tap a thumbnail to play it right here."
    surface="bg-bg-base"
  />

  <ClosingCTA
    headlineLead="Watched enough."
    headlineItalic="Ready to listen?"
    cta={{ label: 'Book a Session', href: '/book' }}
    trustLine="In-person sessions · Stuart, FL"
  />
</Base>
