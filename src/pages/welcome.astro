---
// /welcome: private page for clients who have just booked. Linked only from the
// booking confirmation, never from the nav, footer or any other page. noindex and
// kept out of the sitemap (astro.config.mjs filter + scripts/sitemap-drop-noindex.mjs).
import Base from '@layouts/Base.astro';
import Button from '@components/ui/Button.astro';
import { getSeo } from '@lib/seo';

const seo = getSeo({
  path: '/welcome',
  title: 'Welcome',
  description: 'A short welcome from Dodie after you book your QHHT session.',
  noIndex: true,
});
---
<Base seo={seo} leadMagnet={false} chat={false} pixel={false}>
  <section class="section-y bg-bg-base">
    <div class="container-default">
      <div class="mx-auto max-w-prose text-center">
        <p class="text-xs uppercase tracking-[0.22em] text-brand">You're booked</p>
        <h1 class="mt-4 font-display text-ink">Thank you for booking your session</h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-secondary">A short welcome from Dodie.</p>
      </div>

      <video
        class="mx-auto mt-10 block h-auto w-full max-w-[520px] rounded-lg border border-border-subtle bg-bg-sunken shadow-md"
        width="688"
        height="720"
        controls
        playsinline
        preload="metadata"
        poster="/video/qhht-thank-you-poster.jpg"
        aria-label="A short welcome from Dodie"
      >
        <source src="/video/qhht-thank-you-video.mp4" type="video/mp4" />
        <a href="/video/qhht-thank-you-video.mp4">Watch the welcome video</a>
      </video>

      <div class="mx-auto mt-14 max-w-prose">
        <h2 class="font-display text-2xl text-ink">What happens next</h2>
        <ol class="mt-6 space-y-6 text-ink-secondary leading-relaxed">
          <li>
            <p><strong class="font-medium text-ink">1. Check your inbox.</strong> Your confirmation email has your session details.</p>
          </li>
          <li>
            <p><strong class="font-medium text-ink">2. Read your preparation guide.</strong></p>
            <Button href="/dodie/qhht-pre-session-prep-guide.pdf" external class="mt-3">Open your preparation guide</Button>
          </li>
          <li>
            <p>
              <strong class="font-medium text-ink">3. Questions?</strong> Reply to your confirmation email or call
              <a href="tel:+17722475534" class="text-brand underline underline-offset-4 hover:text-brand-hover">772-247-5534</a>.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>
</Base>
